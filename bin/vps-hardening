#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR/../lib/vps-hardening
# vps-hardening: baseline security hardening for a new Debian/Ubuntu VPS.
# See docs/solution-design.md for the command set and docs/detailed-design.md
# for the contract of the commands implemented so far.

set -Eeuo pipefail
umask 077
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
LC_ALL=C
export PATH LC_ALL

readonly VH_VERSION='0.1.0-dev'

# Installed as /usr/local/bin/vps-hardening with modules in
# /usr/local/lib/vps-hardening; the repository uses the same relative layout.
VH_SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly VH_SELF
readonly VH_LIB_DIR="${VH_SELF%/*/*}/lib/vps-hardening"

if [ ! -r "$VH_LIB_DIR/common.sh" ]; then
  printf '[x] 内部错误：找不到模块目录 %s\n' "$VH_LIB_DIR" >&2
  exit 3
fi
. "$VH_LIB_DIR/common.sh"
. "$VH_LIB_DIR/platform.sh"
. "$VH_LIB_DIR/inputs.sh"
. "$VH_LIB_DIR/probe.sh"
. "$VH_LIB_DIR/preflight.sh"
. "$VH_LIB_DIR/verify.sh"
. "$VH_LIB_DIR/state.sh"
. "$VH_LIB_DIR/pending.sh"
. "$VH_LIB_DIR/apply.sh"

# An unexpected command failure must not look like a FAIL result (exit 1).
# Only the main shell decides: inside $(...) or a pipeline the trap would also
# fire for expected non-zero statuses, and a real failure there reaches the
# main shell through the exit status anyway. Mid-apply, the hook restores first.
vh_on_error() {
  [ "$BASH_SUBSHELL" -eq 0 ] || return 0
  printf '[x] 内部错误：%s 处的命令以状态 %s 结束：%s\n' "$2" "$1" "$3" >&2
  if [ -n "$VH_ABORT_HOOK" ]; then
    "$VH_ABORT_HOOK"
  fi
  exit "$VH_EXIT_INTERNAL"
}
trap 'vh_on_error "$?" "${BASH_SOURCE[0]##*/}:$LINENO" "$BASH_COMMAND"' ERR

usage() {
  cat <<'EOF'
用法：vps-hardening <命令> [参数]

命令：
  preflight   只读预检：检查平台、输入和新机条件，不改变系统
  verify      只读验证：逐项核对加固结果，不改变系统
  apply       应用加固（交互执行），结束后进入待确认
  confirm     在新的 SSH 会话中以 root 确认加固结果
  status      显示状态（尚未实现，里程碑 M4）
  rollback    手工回滚（尚未实现，里程碑 M4）
  ports       变更公开端口（尚未实现，里程碑 M4）

preflight 和 apply 的参数：
  --panel-port PORT        3X-UI 面板端口，只经 SSH 隧道访问（默认 2053）
  --open PORT/PROTO[/FAM]  公开端口，PROTO 为 tcp 或 udp，FAM 为 both、ipv4 或 ipv6，
                           可重复（例如 --open 443/tcp）
  --confirm-timeout MIN    确认时限，3～60 分钟（默认 10）

root 是管理账户，只能用密钥登录；预检要求 root 已有可用的公钥。
加固前请先执行 apt update && apt full-upgrade 并重启。apply 之后须在确认时限内，
从新的 SSH 会话以 root 执行 confirm；到期未确认或期间重启都会自动恢复。

其他：
  --help       显示本帮助
  --version    显示版本

退出码：0 全部通过；1 有不符合项；2 用法或输入错误；3 内部错误。
EOF
}

require_tty() {
  [ -t 0 ] || usage_error "$1 必须在交互终端中运行"
}

not_implemented() {
  usage_error "$1 尚未实现（计划在里程碑 $2 实现）"
}

main() {
  local cmd="${1-}"
  [ "$#" -eq 0 ] || shift
  case "$cmd" in
    preflight) cmd_preflight "$@" ;;
    verify) cmd_verify "$@" ;;
    apply)
      require_tty apply
      cmd_apply "$@"
      ;;
    confirm) cmd_confirm "$@" ;;
    # Run by the systemd units that apply arms; not for interactive use.
    _restore) cmd_restore "$@" ;;
    status | rollback | ports) not_implemented "$cmd" M4 ;;
    --version) printf 'vps-hardening %s\n' "$VH_VERSION" ;;
    --help | -h) usage ;;
    '') usage >&2; exit "$VH_EXIT_USAGE" ;;
    *) usage_error "未知命令：$cmd" ;;
  esac
}

main "$@"
